# Ключи бота. Проще всего заполнить через Мастер настройки (configure.pyw) — он сам создаст .env.
# Этот файл — пример. Настоящий .env никому не показывай и не выкладывай!

# Токен бота: discord.com/developers/applications → твоё приложение → Bot → Reset Token
DISCORD_TOKEN=

# ID твоего сервера (Мастер выберет сам; вручную: «Режим разработчика» → ПКМ по серверу → «Копировать ID»)
GUILD_ID=

# Необязательно: пересылка постов из канала другого сервера — ID_канала_источника:название_нашего_канала,...
NEWS_FORWARDS=

# Необязательно: если ffmpeg не в PATH — полный путь, например C:\ffmpeg\bin\ffmpeg.exe
FFMPEG_PATH=

# Необязательно: токен ВК — для ссылок на плейлисты ВК
VK_TOKEN=
